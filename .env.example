# Copy this file to .env and fill in the real values.
# .env is gitignored - never commit it. A host's own secrets manager works just
# as well: both end up as environment variables, and the code does not care
# which one you use.

# ---- Basic auth that Marketo uses to call your endpoints ----
# Same pair for every service in this repo. Marketo asks for these when you
# install the service. Use a long random string for the password.
MARKETO_USER=
MARKETO_PASSWORD=

# ---- OpenAI (gptCompletion + hearSource) ----
OPENAI_API_KEY=

# ---- Marketo REST API (generateTicket only) ----
# A DIFFERENT credential from MARKETO_USER/PASSWORD above. Those are the basic
# auth Marketo uses to call us; these are how we call Marketo, to look up the
# calling program, create Design Studio folders, upload the pass and write the
# program member field. Create them in Admin -> LaunchPoint as a Custom service
# with an API-Only user who has Access API Files (read-write) and Access API
# Program (read-write).
MARKETO_BASE_URL=https://xxx-xxx-xxx.mktorest.com
MARKETO_CLIENT_ID=
MARKETO_CLIENT_SECRET=

# The Design Studio folder that holds one subfolder of passes per program.
# Create it in Design Studio first, then put its id here - it is the number in
# the URL when you open the folder. There is deliberately no default: a wrong
# folder id would quietly scatter generated passes somewhere unexpected.
TICKET_FOLDER_ID=

# The program member field the pass URL is written to. It must already exist in
# Admin -> Program Member Fields; the API cannot create it. Only change this if
# your subscription named the field something else.
TICKET_FIELD=ticketImage

# ---- Logging spreadsheet (shared by all services) ----
# Each service writes to its own tabs, named after the service, e.g.
#   hearSourceLeads / hearSourceBatches
#   generateTicketLeads / generateTicketBatches
SPREADSHEET_ID=
# Your Marketo instance subdomain, used only to build clickable lead links in
# the Sheets log. It is the first part of the hostname you sign in to:
# app-xxxxx for https://app-xxxxx.marketo.com
MARKETO_INSTANCE=

# ---- Public URL (optional) ----
# The URL Marketo reaches this app on, WITHOUT a trailing slash and without the
# /hearSource suffix. Set it in production (e.g. https://ssfs.example.com).
# Leave it BLANK for local ngrok testing - /install then reads the tunnel URL
# off the incoming request, so a new ngrok URL needs no file changes.
PUBLIC_BASE_URL=

# ---- Google Sheets service account (shared) ----
# Path to the service account JSON file in the repo root.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
